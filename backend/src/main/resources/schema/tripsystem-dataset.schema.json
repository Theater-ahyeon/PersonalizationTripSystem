{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripsystem.local/schema/tripsystem-dataset.schema.json",
  "title": "TripSystem Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "destinations"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/destination" }
    }
  },
  "$defs": {
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "nodes", "edges", "facilities"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edge" }
        },
        "facilities": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/facility" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "lng", "lat"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "distanceMeters",
        "idealSpeedMps",
        "congestion",
        "allowed"
      ],
      "properties": {
        "from": { "type": "integer", "minimum": 1 },
        "to": { "type": "integer", "minimum": 1 },
        "distanceMeters": { "type": "number", "exclusiveMinimum": 0 },
        "idealSpeedMps": { "type": "number", "exclusiveMinimum": 0 },
        "congestion": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["WALK", "BIKE", "SHUTTLE"]
          }
        }
      }
    },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "nodeId"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "nodeId": { "type": "integer", "minimum": 1 },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "uniqueItems": true
        },
        "heat": { "type": "number", "minimum": 0 },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    }
  }
}
