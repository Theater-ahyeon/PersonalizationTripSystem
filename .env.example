# 阿里云百炼 DashScope API Key（勿提交到 Git）
# 获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-key-here

# 最省免费额度预设（90 天内：文字 100 万 Token / 配图 500 张 / 视频 200 秒）
AIGC_TEXT_MODEL=qwen-turbo
AIGC_IMAGE_MODEL=wanx2.0-t2i-turbo
AIGC_VIDEO_MODEL=wanx2.1-t2v-turbo
AIGC_VIDEO_DURATION=5
AIGC_MAX_FRAMES=2
AIGC_VIDEO_RESOLUTION=720P
AIGC_VIDEO_RATIO=16:9
# AIGC_AUDIO_URL=

# 若需要自动配音有声视频，改回 wan2.7-t2v（免费额度仅约 50 秒）
# AIGC_VIDEO_MODEL=wan2.7-t2v
# AIGC_VIDEO_DURATION=8
# AIGC_MAX_FRAMES=3

# AIGC_PORT=5174
